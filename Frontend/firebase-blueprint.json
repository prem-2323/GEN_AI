{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user identifier matching auth UID"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Display name of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar photo URL"
        },
        "createdAt": {
          "type": "string",
          "description": "Account initialization timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "TransformationProject": {
      "title": "TransformationProject",
      "description": "Transformation project including source intelligence, transformation settings, and deliverables",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Project ID matching document ID"
        },
        "userId": {
          "type": "string",
          "description": "ID of the owner user"
        },
        "title": {
          "type": "string",
          "description": "Project title",
          "maxLength": 300
        },
        "description": {
          "type": "string",
          "description": "Project summary description",
          "maxLength": 2000
        },
        "source": {
          "type": "object",
          "description": "Ingested source file metadata and text"
        },
        "config": {
          "type": "object",
          "description": "Audience, tone, and format transformation settings"
        },
        "selectedOutputs": {
          "type": "array",
          "description": "List of selected output deliverable types"
        },
        "analysis": {
          "type": "object",
          "description": "AI analysis extracted tokens and confidence"
        },
        "deliverables": {
          "type": "object",
          "description": "Generated multi-channel deliverables"
        },
        "status": {
          "type": "string",
          "description": "Project status",
          "enum": ["Completed", "Draft", "Processing"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user profile data"
    },
    "/projects/{projectId}": {
      "schema": "TransformationProject",
      "description": "Transformation projects created by users"
    }
  }
}
