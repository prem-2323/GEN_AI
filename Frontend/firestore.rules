rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['userId', 'email']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.email is string && data.email.size() <= 256;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'userId', 'title']) &&
        data.id is string && data.id.size() <= 128 &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() <= 300 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    // Health check endpoint for connection validation
    match /test/connection {
      allow read: if true;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUser(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
        isValidUser(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if false;
    }

    // Transformation Projects collection
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(projectId) &&
        isValidProject(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().id == projectId;
      allow update: if isSignedIn() && isValidId(projectId) &&
        existing().userId == request.auth.uid &&
        isValidProject(incoming()) &&
        incoming().userId == request.auth.uid &&
        incoming().id == existing().id;
      allow delete: if isSignedIn() && isValidId(projectId) && existing().userId == request.auth.uid;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
