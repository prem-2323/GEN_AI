# ==================================================
# Document Intelligence / DocLink Environment Config
# ==================================================

# ── API & Server Configuration ──
APP_NAME="DocLink Document Intelligence Platform"
ENVIRONMENT="production"
PORT=8000
HOST="0.0.0.0"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost"

# ── Neo4j Knowledge Graph Configuration ──
# Note: In Docker Compose, the URI is overridden to bolt://neo4j:7687 automatically.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
GRAPH_BACKEND=neo4j

# ── AI & Local LLM Options (Ollama / Gemini) ──
# Ollama and SD Forge run natively on your host system (outside Docker).
# When running DocLink with Docker Compose, point OLLAMA_BASE_URL to host.docker.internal:
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
# For non-Docker local runs:
# OLLAMA_BASE_URL=http://localhost:11434

TEXT_MODEL=qwen3:4b
VISION_MODEL=gemma3:4b
AI_FALLBACK_ENABLED=true
DETERMINISTIC_EXTRACTION_ENABLED=true

# Optional Gemini API key (fallback if Ollama is offline)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Embedding & Vector Store Configuration ──
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
VECTOR_BACKEND=faiss
FAISS_STORAGE_DIR=storage/vector_db
EMBEDDING_DEVICE=cpu

# ── QUBO Optimization Configuration ──
QUBO_ENABLED=true
QUBO_SOLVER=exact
QUBO_ALPHA=0.5
QUBO_BETA=0.3
QUBO_GAMMA=0.2

# ── Grounded RAG & QLoRA Student Configuration ──
STUDENT_MODEL_PATH=Qwen/Qwen2.5-0.5B-Instruct
STUDENT_ADAPTER_PATH=outputs/distillation/student
DEVICE=cpu
MAX_NEW_TOKENS=256

# ── Quantum Hardware (Future Integration) ──
QUANTUM_BACKEND_ENABLED=false
QUANTUM_PROVIDER=dwave
