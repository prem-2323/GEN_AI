# --- MongoDB Atlas (database `contentforge`, collections: users projects
#     sources uckr deliverables validations jobs temp). NEVER commit real values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=contentforge
TEMP_LOG_INTERVAL_MINUTES=30
TEMP_TTL_HOURS=24

# --- Firebase / GCP ---
# Path to Firebase service account JSON (Firebase Console > Project Settings > Service Accounts).
# Either set this path OR set FIREBASE_SERVICE_ACCOUNT_JSON (inline JSON string).
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_PROJECT_ID=gen-lang-client-0421331706
# Named Firestore database (from Frontend/firebase-applet-config.json).
FIRESTORE_DATABASE_ID=ai-studio-gentransformai-ccc00148-cf41-4379-89fb-7302425611e2
# Phase 8: set to move file bytes to Firebase Storage (metadata stays in MongoDB).
FIREBASE_STORAGE_BUCKET=

# --- Backend ---
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins
EXTRA_CORS_ORIGINS=

# --- File uploads (Phase 2 local storage under STORAGE_ROOT) ---
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTS=pdf,docx,txt,md,png,jpg,jpeg

# --- AI models (Phase 3: Ollama Qwen/Gemma -> Gemini -> extractive fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:7b
GEMMA_MODEL=gemma3:4b
# GEMINI_API_KEY=  (or GOOGLE_API_KEY style env; leave empty to use fallback)
GEMINI_MODEL=gemini-2.5-flash

# --- Dev / Postman testing ---
# When true, backend accepts X-User-Uid (and optional X-User-Email) headers INSTEAD of
# a real Firebase ID token. Useful for Postman before wiring real login.
# NEVER enable in production.
DEV_BYPASS_AUTH=true
