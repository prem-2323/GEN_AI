# --- File Storage Configuration (Phase 2 Local Filesystem Storage) ---
STORAGE_ROOT=./storage
DOCUMENT_STORAGE_ROOT=./storage/documents
DATA_STORAGE_ROOT=./storage/data

# --- Backend ---
PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated extra origins
EXTRA_CORS_ORIGINS=

# --- File uploads (Phase 2 local storage under STORAGE_ROOT) ---
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTS=pdf,docx,txt,md,png,jpg,jpeg

# --- AI models (Phase 3: Analysis Router: Ollama Qwen/Gemma -> Gemini -> Deterministic Grounded Engine) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
TEXT_MODEL=qwen3:4b
VISION_MODEL=gemma3:4b
AI_FALLBACK_ENABLED=true
DETERMINISTIC_EXTRACTION_ENABLED=true
# GEMINI_API_KEY=  (optional client or backend key)
GEMINI_MODEL=gemini-2.5-flash

# --- Graph Database Configuration ---
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Embedding Model Configuration (Phase 3) ---
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

