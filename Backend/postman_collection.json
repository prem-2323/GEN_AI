{
  "info": {
    "name": "ContentForge AI — Full Lifecycle (Phases 1 to 5)",
    "description": "Comprehensive Postman collection for ContentForge AI: Auth, Multi-tenant Projects, Sources, Phase 3 AI Content Understanding (Qwen + Gemma), and Phase 5 Real UCKR Engine (Facts, Entities, Events, Metrics, Claims, Actions, Relationships, Grounded Citations, and Validation).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "idToken", "value": "PASTE_FIREBASE_ID_TOKEN_HERE" },
    { "key": "uidA", "value": "user-A-test-uid" },
    { "key": "uidB", "value": "user-B-test-uid" },
    { "key": "projectId", "value": "proj-phase4-cyber-001" },
    { "key": "sourceId", "value": "src-phase4-cyber-001" }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health 200 + healthy status', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('healthy'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Auth Profile (User A)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Uid", "value": "{{uidA}}" }, { "key": "X-User-Email", "value": "userA@example.com" }],
        "url": "{{baseUrl}}/api/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Auth me 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().uid).to.eql(pm.variables.get('uidA')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Create Project (User A)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Uid", "value": "{{uidA}}" }
        ],
        "url": "{{baseUrl}}/api/projects",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{projectId}}\",\n  \"name\": \"Cyber Threat Intelligence Report\",\n  \"description\": \"Analysis of ransomware campaigns and identity gateway CVE-2026-4418 vulnerabilities.\",\n  \"status\": \"created\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Created 201', () => pm.response.to.have.status(201));",
              "pm.test('Ownership verified', () => { const j = pm.response.json(); pm.expect(j.id).to.eql(pm.variables.get('projectId')); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Add Source Content (PDF with Extracted Text)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Uid", "value": "{{uidA}}" }
        ],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{sourceId}}\",\n  \"name\": \"Cyber_Threat_Intelligence_Report.pdf\",\n  \"type\": \"PDF\",\n  \"pages\": 14,\n  \"size\": \"4.2 MB\",\n  \"extractedText\": \"Organization X detected a ransomware campaign on 15 August 2026 affecting 25 systems. The attack exploited CVE-2026-4418 in the Identity Gateway. 34 organizations were compromised in 72 hours with mean lateral movement of 18 minutes. CVSS score was evaluated at 9.9. Security teams must deploy patch 2.4 immediately and enforce 15-minute token rotation.\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Source added 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Phase 3: AI Content Understanding (Qwen + Gemma)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Uid", "value": "{{uidA}}" }
        ],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/analysis",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"forceRefresh\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Analysis completed 200', () => { pm.response.to.have.status(200); const j = pm.response.json(); pm.expect(j.status).to.eql('completed'); pm.expect(j.textAnalysis.facts.length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Phase 4: Build Real UCKR Knowledge Base",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Uid", "value": "{{uidA}}" }
        ],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/uckr"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('UCKR Created 201', () => pm.response.to.have.status(201));",
              "pm.test('UCKR Structure Valid', () => { const j = pm.response.json(); pm.expect(j.status).to.eql('valid'); pm.expect(j.version).to.eql(1); pm.expect(j.uckr.facts.length).to.be.above(0); pm.expect(j.uckr.entities.length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Phase 4: Get Source UCKR",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Uid", "value": "{{uidA}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/uckr"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Get Source UCKR 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().uckr.version).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Phase 4: Get UCKR Validation Report",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Uid", "value": "{{uidA}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/uckr/validation"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Validation Report 200', () => { pm.response.to.have.status(200); const v = pm.response.json().validation; pm.expect(v.status).to.eql('valid'); pm.expect(v.groundingCoverage).to.be.above(90); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Phase 4: Rebuild UCKR (Creates Version 2)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Uid", "value": "{{uidA}}" }
        ],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/uckr/rebuild"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Rebuild 200', () => pm.response.to.have.status(200));",
              "pm.test('Version incremented to 2', () => { pm.expect(pm.response.json().version).to.eql(2); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Phase 4: Get Specific UCKR Version (v1)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Uid", "value": "{{uidA}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/uckr/1"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Historical Version 1 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().uckr.version).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Phase 4: Get Project-Level UCKR (Frontend convenience)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Uid", "value": "{{uidA}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/uckr"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Project UCKR 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().uckr.facts.length).to.be.above(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Security: Cross-Tenant Denial (User B)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Uid", "value": "{{uidB}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}/sources/{{sourceId}}/uckr"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Cross-tenant 403 Forbidden', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Cleanup Project",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-User-Uid", "value": "{{uidA}}" }],
        "url": "{{baseUrl}}/api/projects/{{projectId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Delete project 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
